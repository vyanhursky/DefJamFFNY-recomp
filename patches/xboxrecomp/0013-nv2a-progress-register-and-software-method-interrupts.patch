+/*
+ * PGRAPH software methods: a NOP that carries a parameter.
+ *
+ * NV097_NO_OPERATION with a non-zero parameter is how Direct3D asks the GPU
+ * for an interrupt at a point in the push buffer. The GPU raises PGRAPH's
+ * error interrupt with the notification source and the trapped method and
+ * data, and D3D's deferred routine hands the data to a software-method
+ * handler (Def Jam: Fight for NY, sub_00223760 -> sub_002234F0). D3D uses it
+ * to wait for push-buffer space: it writes NOP(5), kicks off, and blocks on an
+ * event that handler sets -- so with nothing raised it blocks for ever. xemu
+ * models the same thing in its NV097_NO_OPERATION case.
+ *
+ * The executor queues each one as it reaches it (nv2a_pb_exec.c); the timer
+ * thread delivers them one per tick, because the service and deferred routines
+ * need a guest stack and TIB, which only it has. Delivered the way the PTIMER
+ * alarm is: claim the summary, set the status registers, raise, drain, clear.
+ *
+ * ponytail: the GPU does not stall until the interrupt is acknowledged, as the
+ * hardware does. The executor has already run past the NOP by the time it is
+ * delivered, which a title that inspects GPU state from its handler could see.
+ */
+#define NV2A_PGRAPH_INTR          0x00400100u
+#define NV2A_PGRAPH_INTR_ERROR    (1u << 20)
+#define NV2A_PGRAPH_NSOURCE       0x00400108u
+#define NV2A_PGRAPH_NSOURCE_NOTIFICATION 1u
+#define NV2A_PGRAPH_TRAPPED_ADDR  0x00400704u
+#define NV2A_PGRAPH_TRAPPED_DATA  0x00400708u
+#define NV2A_PMC_INTR_PGRAPH      (1u << 12)
+#define PGRAPH_SWM_QUEUE          256
+
+static volatile LONG g_swm_head, g_swm_tail;
+static struct { uint32_t method, data; } g_swm_queue[PGRAPH_SWM_QUEUE];
+
+void kernel_nv2a_software_method(uint32_t subch, uint32_t method, uint32_t data)
+{
+    LONG tail = g_swm_tail, next = (tail + 1) % PGRAPH_SWM_QUEUE;
+    if (next == g_swm_head) {
+        static int dropped;
+        if (dropped++ < 3)
+            fprintf(stderr, "  [PGRAPH] software-method queue full; dropping 0x%X(0x%X)\n",
+                    method, data);
+        return;
+    }
+    g_swm_queue[tail].method = (subch << 13) | (method & 0x1FFC);
+    g_swm_queue[tail].data = data;
+    MemoryBarrier();
+    g_swm_tail = next;
+}
+
+static void kernel_pgraph_tick(void)
+{
+    uint32_t method, data;
+    int claimed, queued;
+    LONG before;
+    static unsigned n;
+
+    if (g_swm_head == g_swm_tail || !xbox_GetConnectedInterrupt(NV2A_VECTOR))
+        return;
+    method = g_swm_queue[g_swm_head].method;
+    data = g_swm_queue[g_swm_head].data;
+    g_swm_head = (g_swm_head + 1) % PGRAPH_SWM_QUEUE;
+
+    InterlockedIncrement(&g_nv2a_intr_inflight);
+    /* Say PGRAPH and only PGRAPH, as the PTIMER delivery does. The deferred
+     * routine services every summary bit it finds, and the vertical blank's
+     * are left standing: serviced from here, D3D's blank handler
+     * (sub_002231D0) spun on this thread and every later interrupt stopped. */
+    BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PMC_INTR_0) &=
+        ~(NV2A_PMC_INTR_PCRTC | NV2A_PMC_INTR_PTIMER);
+    BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PCRTC_INTR_0) &= ~NV2A_PCRTC_INTR_VBLANK;
+    BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PMC_INTR_EN_0) |= NV2A_PMC_INTR_PGRAPH;
+    BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PGRAPH_TRAPPED_ADDR) = method;
+    BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PGRAPH_TRAPPED_DATA) = data;
+    BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PGRAPH_NSOURCE) = NV2A_PGRAPH_NSOURCE_NOTIFICATION;
+    BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PGRAPH_INTR) = NV2A_PGRAPH_INTR_ERROR;
+    BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PMC_INTR_0) |= NV2A_PMC_INTR_PGRAPH;
+    before = g_dpc_tail;
+    claimed = kernel_raise_interrupt(NV2A_VECTOR);
+    queued = (g_dpc_tail != before);
+    kernel_drain_dpcs();
+    /* Write-1-to-clear on hardware; plain memory needs telling. */
+    BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PGRAPH_INTR) = 0;
+    BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PGRAPH_NSOURCE) = 0;
+    BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PMC_INTR_0) &= ~NV2A_PMC_INTR_PGRAPH;
+    InterlockedDecrement(&g_nv2a_intr_inflight);
+    if (n++ < 10 || (n % 500) == 0)
+        fprintf(stderr, "  [PGRAPH] software method 0x%04X(0x%X) -> ISR %s, %s (#%u)\n",
+                method, data, claimed < 0 ? "not callable" :
+                claimed ? "claimed it" : "declined it",
+                queued ? "queued work" : "queued nothing", n);
+}
+
 /* Run whatever is queued. Called from the timer thread, which has the guest
  * stack and TIB that a deferred routine needs. */
 static void kernel_drain_dpcs(void)
@@ -2571,6 +2663,8 @@ static DWORD WINAPI kernel_timer_thread(LPVOID unused)
         Sleep(1);
         kernel_vblank_tick();  /* the GPU's frame clock */
         kernel_ptimer_tick();  /* and its programmable alarm */
+        for (int swm = 0; swm < PGRAPH_SWM_QUEUE; swm++)   /* all pending: a frame raises dozens */
+            kernel_pgraph_tick();  /* and software methods the push buffer raised */
         kernel_drain_dpcs();   /* deferred work, before due timers */
         now = (long long)GetTickCount64();
 
