diff --git a/src/kernel/xbox_memory_layout.c b/src/kernel/xbox_memory_layout.c
index 0fb5c13..a9b8a5f 100644
--- a/src/kernel/xbox_memory_layout.c
+++ b/src/kernel/xbox_memory_layout.c
@@ -2231,20 +2231,21 @@ BOOL xbox_MemoryLayoutInit(const void *xbe_data, size_t xbe_size)
                  * Enabled by the same variable, because neither half is any
                  * use without the other.
                  *
-                 * Only the registers and the VP (0x00000-0x2FFFF) fault. From
-                 * 0x30000 up are the GP and EP DSPs' own memories, which the
-                 * emulated APU ignores; trapped, a read there returned zero,
-                 * and a host memcpy out of them (Def Jam, loading a match:
-                 * from 0xFE830200) faulted outright, its AVX load being
-                 * nothing the MMIO decoder handles. As plain memory they read
-                 * back what was written, as the DSPs' RAM does. */
+                 * All of it, the GP and EP DSPs' memories and control words
+                 * (0x30000 up) included, though the emulated APU ignores them
+                 * and a read there returns zero. Backed as plain memory for a
+                 * while, they read back what DirectSound had written, and the
+                 * movie player waited for ever on a DSP that never answered
+                 * (4 start-ups in ~20). The copy that made that tempting -- a
+                 * host memcpy out of the GP memory, which the MMIO decoder
+                 * cannot follow -- is now a word loop in the lifter. */
                 DWORD old_protect;
-                if (VirtualProtect((char *)g_mcpx_memory, 0x00030000u,
+                if (VirtualProtect((char *)g_mcpx_memory, 0x00080000u,
                                    PAGE_NOACCESS, &old_protect))
                     g_apu_mmio_trapped = 1;
                 if (g_apu_mmio_trapped)
                     fprintf(stderr, "  APU: 0x%08X..0x%08X trapped for MMIO\n",
-                            XBOX_MCPX_BASE, XBOX_MCPX_BASE + 0x00030000u);
+                            XBOX_MCPX_BASE, XBOX_MCPX_BASE + 0x00080000u);
                 *(volatile uint32_t *)((char *)g_mcpx_memory
                                        + MCPX_AC97_CODEC_STATUS)
                     |= MCPX_AC97_CODEC_READY;
diff --git a/tools/recomp/lifter.py b/tools/recomp/lifter.py
index 4ac4ed5..18745bb 100644
--- a/tools/recomp/lifter.py
+++ b/tools/recomp/lifter.py
@@ -2494,12 +2494,19 @@ class Lifter:
         # only the common direction took the shortcut.
         #
         # memcpy is still used when the ranges provably do not overlap, which
-        # is the overwhelming majority of calls.
+        # is the overwhelming majority of calls -- and neither side is in the
+        # hardware windows (NV2A at 0xFD000000, the MCPX devices from
+        # 0xFE800000). Those can be trapped for MMIO, and the fault handler
+        # decodes ordinary moves, not the vector loads a host memcpy uses: Def
+        # Jam copying out of the APU's DSP memory while loading a match died
+        # on a VMOVDQU. There the copy goes a word at a time, through the
+        # volatile MEM accessors, each access an ordinary move.
         if "movsb" in m:
             return ["if (!g_df) { uint8_t *_d = (uint8_t*)XBOX_PTR(edi),"
                     " *_s = (uint8_t*)XBOX_PTR(esi); uint32_t _n = ecx;",
-                    "  if (_d + _n <= _s || _s + _n <= _d) memcpy(_d, _s, _n);",
-                    "  else { uint32_t _i; for (_i = 0; _i < _n; _i++) _d[_i] = _s[_i]; }",
+                    "  if ((_d + _n <= _s || _s + _n <= _d) && esi < 0xFD000000u && edi < 0xFD000000u)"
+                    " memcpy(_d, _s, _n);",
+                    "  else { uint32_t _i; for (_i = 0; _i < _n; _i++) MEM8(edi + _i) = MEM8(esi + _i); }",
                     "  esi += ecx; edi += ecx; }",
                     "else { uint32_t _i; for (_i = 0; _i < ecx; _i++)"
                     " MEM8(edi - _i) = MEM8(esi - _i); esi -= ecx; edi -= ecx; }",
@@ -2507,7 +2514,8 @@ class Lifter:
         if "movsd" in m:
             return ["if (!g_df) { uint8_t *_d = (uint8_t*)XBOX_PTR(edi),"
                     " *_s = (uint8_t*)XBOX_PTR(esi); uint32_t _n = ecx * 4;",
-                    "  if (_d + _n <= _s || _s + _n <= _d) memcpy(_d, _s, _n);",
+                    "  if ((_d + _n <= _s || _s + _n <= _d) && esi < 0xFD000000u && edi < 0xFD000000u)"
+                    " memcpy(_d, _s, _n);",
                     "  else { uint32_t _i; for (_i = 0; _i < ecx; _i++)"
                     " MEM32(edi + _i*4) = MEM32(esi + _i*4); }",
                     "  esi += ecx * 4; edi += ecx * 4; }",
@@ -2517,7 +2525,8 @@ class Lifter:
         if "movsw" in m:
             return ["if (!g_df) { uint8_t *_d = (uint8_t*)XBOX_PTR(edi),"
                     " *_s = (uint8_t*)XBOX_PTR(esi); uint32_t _n = ecx * 2;",
-                    "  if (_d + _n <= _s || _s + _n <= _d) memcpy(_d, _s, _n);",
+                    "  if ((_d + _n <= _s || _s + _n <= _d) && esi < 0xFD000000u && edi < 0xFD000000u)"
+                    " memcpy(_d, _s, _n);",
                     "  else { uint32_t _i; for (_i = 0; _i < ecx; _i++)"
                     " MEM16(edi + _i*2) = MEM16(esi + _i*2); }",
                     "  esi += ecx * 2; edi += ecx * 2; }",
diff --git a/tools/recomp/test_lifter_direction_flag.py b/tools/recomp/test_lifter_direction_flag.py
index d7f1e39..7da25ca 100644
--- a/tools/recomp/test_lifter_direction_flag.py
+++ b/tools/recomp/test_lifter_direction_flag.py
@@ -55,9 +55,19 @@ class DirectionFlagLifterTest(unittest.TestCase):
 
         # An explicit ascending byte loop, not memmove: memmove would give the
         # copy-through-a-temporary answer, which is a different result.
-        self.assertIn("for (_i = 0; _i < _n; _i++) _d[_i] = _s[_i];", generated)
+        self.assertIn("for (_i = 0; _i < _n; _i++) MEM8(edi + _i) = MEM8(esi + _i);", generated)
         self.assertNotIn("memmove", generated)
 
+    def test_rep_movs_never_memcpys_a_hardware_window(self):
+        """A copy touching 0xFD000000 and up goes a word at a time.
+
+        Those windows can be trapped for MMIO, and the fault handler decodes
+        ordinary moves, not the vector loads a host memcpy uses.
+        """
+        for text, raw in (("rep movsb", "f3a4"), ("rep movsd", "f3a5")):
+            generated = _lift(Instruction(0, 2, text, "", raw))
+            self.assertIn("esi < 0xFD000000u && edi < 0xFD000000u", generated)
+
     def test_rep_movsb_backward_case_is_still_a_loop(self):
         generated = _lift(Instruction(0, 2, "rep movsb", "", "f3a4"))
 
