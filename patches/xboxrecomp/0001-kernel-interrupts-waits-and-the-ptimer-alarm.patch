+/*
+ * The GPU's programmable alarm, which is how a title paces itself.
+ *
+ * PTIMER is a free-running counter with a comparator. Software programs the
+ * rate through NUMERATOR and DENOMINATOR, resets the count, writes a deadline
+ * to ALARM_0 and enables INTR_EN_0; the hardware raises the GPU interrupt when
+ * the count passes the deadline, and the driver's service routine runs
+ * whatever was waiting on it.
+ *
+ * Def Jam: Fight for NY builds its entire frame clock on this. Its Direct3D
+ * (statically linked, so it drives the registers itself) programs 56966/7629,
+ * resets the count, and arms the alarm 16,838,770 ticks ahead -- 16.84 ms, one
+ * frame at 59.4 Hz. The service routine credits one simulation frame and arms
+ * the next alarm. With nothing raising that interrupt the credit never
+ * arrives, so the title renders for ever and never advances: not a hang, an
+ * un-ticked simulation. This is also what xemu's open issue #1124 for this
+ * title calls "an unsupported PTimer operation".
+ *
+ * The ratio is how software asks for the units it wants. Every XDK title
+ * programs it for nanoseconds, and this title's numbers confirm it: 16,838,770
+ * ns is exactly one frame. The base clock that ratio scales is not documented
+ * anywhere this project can check, so it is inferred from that requirement --
+ * 1e9 * 7629 / 56966, about 133.92 MHz -- which makes a title with different
+ * values scale correctly if the inference is right, and this one exact either
+ * way.
+ *
+ * TIME_0 holds the low 32 bits of the count and TIME_1 the rest, and ALARM_0
+ * is compared against TIME_0. Some references describe TIME_0 as the low 27
+ * bits shifted up by five; that did not match this title's arithmetic, and the
+ * deadline it writes is what settles it. It reads TIME_0, adds 16,838,770 and
+ * writes that to ALARM_0, so one unit of TIME_0 is one nanosecond, and the
+ * counter wraps its 32 bits every 4.3 seconds -- comfortably longer than any
+ * deadline it sets, which is what the signed comparison below needs.
+ *
+ * Kept in plain guest memory rather than behind a trap: a trapped page can
+ * only be serviced from the faulting thread, and raising a guest interrupt
+ * needs the guest stack and TIB that the timer thread owns. The title writes
+ * TIME_0/TIME_1 to reset the count, which shows up here as the registers
+ * holding something this function did not put there.
+ */
+#define NV2A_PTIMER_INTR_0     0x00009100u
+#define NV2A_PTIMER_INTR_ALARM (1u << 0)
+#define NV2A_PTIMER_INTR_EN_0  0x00009140u
+#define NV2A_PTIMER_NUMERATOR  0x00009200u
+#define NV2A_PTIMER_DENOM      0x00009210u
+#define NV2A_PTIMER_TIME_0     0x00009400u
+#define NV2A_PTIMER_TIME_1     0x00009410u
+#define NV2A_PTIMER_ALARM_0    0x00009420u
+#define NV2A_PMC_INTR_PTIMER   (1u << 20)
+/* 1e9 * 7629 / 56966: the base that makes the XDK's ratio come out in
+ * nanoseconds. See the note above. */
+#define NV2A_PTIMER_BASE_HZ    133919881ull
+
+
+static void kernel_ptimer_tick(void)
+{
+    static int      enabled = -1;
+    static uint64_t origin_qpc;          /* host counter at the last reset */
+    static uint64_t issued;              /* the count we last published     */
+    static LARGE_INTEGER qpc_freq;
+    static int      pending;             /* alarm raised, not yet re-armed  */
+    static uint32_t fired_alarm;         /* the deadline that raised it     */
+
+    uint32_t reg_lo, reg_hi, alarm, intr_en, num, den;
+    uint64_t now, rate;
+    LARGE_INTEGER qpc;
+
+    if (enabled < 0) {
+        enabled = getenv("RECOMP_NO_PTIMER") == NULL;
+        QueryPerformanceFrequency(&qpc_freq);
+        if (!qpc_freq.QuadPart)
+            enabled = 0;
+    }
+    if (!enabled)
+        return;
+
+    reg_lo  = BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PTIMER_TIME_0);
+    reg_hi  = BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PTIMER_TIME_1);
+    alarm   = BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PTIMER_ALARM_0);
+    intr_en = BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PTIMER_INTR_EN_0);
+    num     = BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PTIMER_NUMERATOR);
+    den     = BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PTIMER_DENOM);
+
+    QueryPerformanceCounter(&qpc);
+
+    /* A reset: the registers no longer hold what was published, so the title
+     * has written its own value and the count starts again from there. */
+    if (reg_lo != (uint32_t)issued || reg_hi != (uint32_t)(issued >> 32)) {
+        origin_qpc = (uint64_t)qpc.QuadPart;
+        issued = ((uint64_t)reg_hi << 32) | reg_lo;
+        pending = 0;
+    }
+
+    rate = (num && den) ? NV2A_PTIMER_BASE_HZ * num / den : 1000000000ull;
+    {
+        uint64_t elapsed = (uint64_t)qpc.QuadPart - origin_qpc;
+        uint64_t secs = elapsed / (uint64_t)qpc_freq.QuadPart;
+        uint64_t rem  = elapsed % (uint64_t)qpc_freq.QuadPart;
+        now = issued + secs * rate + (rem * rate) / (uint64_t)qpc_freq.QuadPart;
+    }
+
+    BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PTIMER_TIME_0) = (uint32_t)now;
+    BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PTIMER_TIME_1) = (uint32_t)(now >> 32);
+    issued = now;
+
+    /* ALARM_0 is compared against TIME_0's low word, so the difference is read
+     * as signed: a deadline just behind the count has passed, one far ahead
+     * has not. 0xFFFFFFFF is how a title parks the comparator. */
+    if (!(intr_en & NV2A_PTIMER_INTR_ALARM) || alarm == 0xFFFFFFFFu) {
+        pending = 0;
+        return;
+    }
+    /* The service routine acknowledges by writing INTR_0 and then arms the
+     * next deadline. A different value in ALARM_0 is that re-arm, and is the
+     * signal to stop holding the last one: without it the alarm fires once and
+     * the title's clock stops again, which is the whole bug wearing a hat.
+     * The pending bits are dropped here too, because they are write-1-to-clear
+     * on hardware and plain memory cannot do that for itself. */
+    if (pending && alarm != fired_alarm) {
+        pending = 0;
+        BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PTIMER_INTR_0) &= ~NV2A_PTIMER_INTR_ALARM;
+    }
+    if (pending) {
+        static unsigned held;
+        if (held++ == 2000)
+            fprintf(stderr, "  [PTIMER] alarm 0x%08X still held after two "
+                            "seconds: INTR_0=0x%X EN=0x%X\n", fired_alarm,
+                    BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PTIMER_INTR_0),
+                    intr_en);
+        return;
+    }
+    if ((int32_t)((uint32_t)now - alarm) < 0)
+        return;
+
+    pending = 1;
+    fired_alarm = alarm;
+
+    /* Claim the summary register before touching it, not after. The
+     * acknowledging loop runs flat out, so a bit set even a moment before the
+     * flag goes up can be erased before the service routine reads it -- which
+     * reads as an interrupt with no source, and the routine correctly declines
+     * one. */
+    InterlockedIncrement(&g_nv2a_intr_inflight);
+    /* Say PTIMER and only PTIMER. The vertical blank sets its own summary
+     * and status bits a few lines above and nothing clears them promptly, so
+     * a routine reading the summary during this delivery could find PCRTC
+     * still asserting, service the blank and return having claimed an
+     * interrupt it never looked at. Both routines are the same routine --
+     * one vector, one service routine, distinguished only by these bits. */
+    BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PMC_INTR_0)   &= ~NV2A_PMC_INTR_PCRTC;
+    BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PCRTC_INTR_0) &= ~NV2A_PCRTC_INTR_VBLANK;
+    BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PTIMER_INTR_0) |= NV2A_PTIMER_INTR_ALARM;
+    BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PMC_INTR_0)    |= NV2A_PMC_INTR_PTIMER;
+    {
+        static unsigned n;
+        LONG before = g_dpc_tail;
+        int claimed, queued;
+
+        /* The service routine claims the interrupt and queues the real work;
+         * the deferred routine then reads PMC_INTR_0 *again* to decide which
+         * block to service. So the summary has to survive both, not just the
+         * first. Draining here rather than waiting for the next pass keeps
+         * that window as short as it can be. */
+        claimed = kernel_raise_interrupt(NV2A_VECTOR);
+        queued = (g_dpc_tail != before);
+        kernel_drain_dpcs();
+        BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PMC_INTR_0) &= ~NV2A_PMC_INTR_PTIMER;
+        InterlockedDecrement(&g_nv2a_intr_inflight);
+        uint32_t qroutine = queued
+            ? BRIDGE_MEM32(g_dpc_queue[before].dpc + 12) : 0;
+        /* The routine has run and acknowledged, so drop the status bit for
+         * it. INTR_0 is write-1-to-clear on hardware and plain memory cannot
+         * do that for itself, so a bit left set reads as an interrupt still
+         * asserting and the next one is declined -- which is what stopped
+         * this title's frame clock after a single alarm. */
+        BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PTIMER_INTR_0) &=
+            ~NV2A_PTIMER_INTR_ALARM;
+        BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PMC_INTR_0) &= ~NV2A_PMC_INTR_PTIMER;
+        if (n++ < 20 || (n % 500) == 0)
+            fprintf(stderr, "  [PTIMER] alarm 0x%08X -> ISR %s, %s (routine 0x%08X) (#%u)\n",
+                    alarm, claimed < 0 ? "not callable" :
+                    claimed ? "claimed it" : "declined it",
+                    queued ? "queued work" : "queued nothing", qroutine, n);
+        fflush(stderr);
+    }
+}
