+    def _snapshot_alu_result(self, insn, ops, m):
+        """Publish the flags of an add/sub/and/or/xor for a jcc in a later block.
+
+        Inside a block a jcc re-reads the result through the flag tracking,
+        but a jcc that starts a block -- a label reached from more than one
+        place -- reads the published _zf/_sf/_fa/_fb, which only cmp, test,
+        inc and dec used to write. After an ALU op those were whatever an
+        earlier compare had left. Def Jam's texture setup rounds a row up to
+        64 bytes like this:
+
+            and  eax, 8000003Fh   ; row bytes mod 64
+            jns  skip
+            dec eax / or eax, -40h / inc eax
+          skip:                   ; two predecessors
+            je   no_padding       ; ZF of the AND
+            padding = 40h - eax
+
+        and with ZF stale the padding was 64 for every row already aligned,
+        so each linear texture got a pitch 64 bytes too wide and the fight's
+        text came out sheared into noise.
+
+        sub sets exactly a cmp's flags, so it snapshots as one, before its
+        write. The others snapshot their result, after it; OF is 0 for the
+        logical ops and left alone for add. Callers emit this only where the
+        op is the last flag-setter of its block, so blocks that never hand
+        flags on pay nothing.
+        """
+        if len(ops) < 2:
+            return []
+        if m == "sub":
+            return self._snapshot_flags(insn, ops, "cmp")
+        size = _operand_width(ops[0]) or 4
+        if size not in self._SNAP_MASK:
+            size = 4
+        mask, sx = self._SNAP_MASK[size], self._SNAP_SX[size]
+        res = _fmt_operand_read(ops[0])
+        out = [f"_fa = (uint32_t)({res}) & {mask}; _fb = _fa;",
+               f"_fas = (int32_t){sx}(_fa); _fbs = _fas; /* {m} result ({size*8}-bit) */",
+               "_zf = (int)(_fa == 0);", "_fcmp = 0;",
+               "_sf = (int)((_fa >> %d) & 1);" % (size * 8 - 1)]
+        if m != "add":
+            out.append("_of = 0; /* logical op clears OF */")
+        return out
+
     def _lift_cmp(self, insn, ops):
         if len(ops) < 2:
             return ["/* cmp: bad operands */"]
