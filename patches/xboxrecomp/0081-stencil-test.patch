+            dev->lpVtbl->SetRenderState(dev, D3DRS_STENCILWRITEMASK, g_pg.stencil_wmask);
+            dev->lpVtbl->SetRenderState(dev, D3DRS_STENCILFAIL, nv2a_stencil_op_to_d3d(g_pg.stencil_fail));
