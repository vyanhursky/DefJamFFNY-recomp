@@ -1146,6 +1181,24 @@ static int ready_state(IDirect3DDevice8 *dev, float *zscale)
         dev->lpVtbl->SetRenderState(dev, D3DRS_ZFUNC, nv2a_cmp_to_d3d(g_pg.depth_func));
