diff --git a/src/kernel/nv2a_pb_exec.c b/src/kernel/nv2a_pb_exec.c
index ca5c182..e0ca555 100644
--- a/src/kernel/nv2a_pb_exec.c
+++ b/src/kernel/nv2a_pb_exec.c
@@ -559,6 +559,18 @@ static int fetch_attr(const VertexAttr *a, uint32_t index, float out[4])
         for (i = 0; i < a->size && i < 4; i++)
             out[i] = (float)((const int16_t *)p)[i];
         return 1;
+    case 6: {                                /* packed normal: 11, 11, 10 bits */
+        /* Three signed normalised components in one dword, x lowest
+         * (D3DVSDT_NORMPACKED3). Def Jam's skinned characters carry their
+         * normals this way; read as absent, every vertex took the current
+         * normal (1,1,1) and the lighting was the same from all sides -- a
+         * pale wash over every model. */
+        uint32_t v = *(const uint32_t *)p;
+        out[0] = (float)((int32_t)(v << 21) >> 21) / 1023.0f;
+        out[1] = (float)((int32_t)(v << 10) >> 21) / 1023.0f;
+        out[2] = (float)((int32_t)v >> 22) / 511.0f;
+        return 1;
+    }
     default:
         return 0;
     }
@@ -1608,15 +1620,25 @@ static void bind_texture_ready(void)
         argb[i] = idx[i] < s_gpu.tex.palette_len ? pal[idx[i]] : 0;
     pgraph_d3d11_replace_texture_ready(key, argb, w, h, NV097_TEXFMT_LU_IMAGE_A8R8G8B8);
     {
-        /* RECOMP_PAL_DUMP=<texture address>,<file>: the ARGB this path made of
-         * that palettised texture, as a BMP, once -- what is uploaded. */
+        /* RECOMP_PAL_DUMP=<texture address>[~<mask>],<file>: the ARGB this path
+         * made of that palettised texture, as a BMP -- what is uploaded,
+         * rewritten each time it is expanded again, so the file is its latest
+         * state. With a mask, every texture whose address matches under it
+         * goes to <file>-<address>.bmp. */
         const char *e = getenv("RECOMP_PAL_DUMP");
         static int done;
-        char *comma;
-        if (e && !done && (comma = strchr(e, ',')) != NULL
-                && strtoul(e, NULL, 0) == s_gpu.tex.offset) {
-            FILE *f = fopen(comma + 1, "wb");
-            done = 1;
+        char *comma, *slash;
+        uint32_t want = e ? (uint32_t)strtoul(e, &slash, 0) : 0;
+        uint32_t mask = (e && *slash == '~') ? (uint32_t)strtoul(slash + 1, NULL, 0) : 0xFFFFFFFFu;
+        if (e && (comma = strchr(e, ',')) != NULL
+                && (s_gpu.tex.offset & mask) == (want & mask)) {
+            char name[600];
+            FILE *f;
+            if (mask == 0xFFFFFFFFu)
+                snprintf(name, sizeof name, "%s", comma + 1);
+            else
+                snprintf(name, sizeof name, "%s-%08X.bmp", comma + 1, s_gpu.tex.offset);
+            f = fopen(name, "wb");
             if (f) {
                 uint8_t hdr[54];
                 uint32_t filesz = 54 + w * h * 4, x, y;
@@ -1632,8 +1654,9 @@ static void bind_texture_ready(void)
                     for (x = 0; x < w; x++)
                         fwrite(&argb[y * w + x], 4, 1, f);
                 fclose(f);
-                fprintf(stderr, "  [PAL] wrote 0x%08X (%ux%u, palette 0x%08X) to %s%c",
-                        s_gpu.tex.offset, w, h, s_gpu.tex.palette, comma + 1, 10);
+                if (done++ < 8)
+                    fprintf(stderr, "  [PAL] wrote 0x%08X (%ux%u, palette 0x%08X) to %s%c",
+                            s_gpu.tex.offset, w, h, s_gpu.tex.palette, name, 10);
             }
         }
     }
