diff --git a/tools/recomp/test_lifter_rotate_width.py b/tools/recomp/test_lifter_rotate_width.py
new file mode 100644
index 0000000..fd533ee
--- /dev/null
+++ b/tools/recomp/test_lifter_rotate_width.py
@@ -0,0 +1,157 @@
+"""Self-check for `rol`/`ror` at 8 and 16 bits.
+
+Both used to lift to ROL32/ROR32 of the zero-extended operand at every width.
+An 8-bit rotate wraps bit 7 into bit 0; the 32-bit rotate moved it to bit 8,
+and the partial-register write then cut it off. The CRT's x87 argument
+classifier turns fxam's condition codes into a table index with
+`shl cl,1 / sar cl,1 / rol cl,1`, so every zero argument to its fmod/sin/atan2
+intrinsics was classified wrongly and sent down the error path; Def Jam's movie
+clips then decomposed an identity matrix into a 2477% scale and a -6e14 degree
+rotation.
+
+Same harness as test_lifter_sar_width.py: the lifter's own output is compiled
+and swept against a reference rotate of the operand's width, and a negative
+control requires the pre-fix expression to fail the same sweep.
+"""
+
+import os
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+from .disasm import Instruction, Operand
+from .lifter import Lifter, _fmt_operand_read, _fmt_operand_write
+
+
+def _rot(m, dst, cnt):
+    insn = Instruction(0, 2, m, "", "00")
+    insn.operands = [dst, cnt]
+    lifted = Lifter().lift_instruction(insn)
+    assert len(lifted) == 1, lifted
+    return lifted[0]
+
+
+def _legacy(m, dst, cnt):
+    """The pre-fix statement: a 32-bit rotate at every width."""
+    func = "ROL32" if m == "rol" else "ROR32"
+    return _fmt_operand_write(
+        dst, f"{func}({_fmt_operand_read(dst)}, {_fmt_operand_read(cnt)})")
+
+
+PRELUDE = r"""
+#include <stdint.h>
+#include <stdio.h>
+#define LO8(r)  ((uint8_t)((r) & 0xFF))
+#define HI8(r)  ((uint8_t)(((r) >> 8) & 0xFF))
+#define LO16(r) ((uint16_t)((r) & 0xFFFF))
+#define SET_LO8(r, v)  ((r) = ((r) & 0xFFFFFF00u) | ((uint32_t)(uint8_t)(v)))
+#define SET_HI8(r, v)  ((r) = ((r) & 0xFFFF00FFu) | (((uint32_t)(uint8_t)(v)) << 8))
+#define SET_LO16(r, v) ((r) = ((r) & 0xFFFF0000u) | ((uint32_t)(uint16_t)(v)))
+static uint8_t g_ram[64];
+#define MEM8(a)  (*(volatile uint8_t *)(g_ram + (a)))
+#define MEM16(a) (*(volatile uint16_t *)(g_ram + (a)))
+static inline uint32_t ROL32(uint32_t val, int n) { n &= 31; return n ? (val << n) | (val >> (32 - n)) : val; }
+static inline uint32_t ROR32(uint32_t val, int n) { n &= 31; return n ? (val >> n) | (val << (32 - n)) : val; }
+static uint32_t ref(int left, uint32_t v, uint32_t c, unsigned w) {
+    uint32_t mask = w == 32 ? 0xFFFFFFFFu : ((1u << w) - 1u), n = (c & 31u) % w;
+    v &= mask;
+    if (!n) return v;
+    return (left ? (v << n) | (v >> (w - n)) : (v >> n) | (v << (w - n))) & mask;
+}
+"""
+
+BODY = r"""
+int main(void) {
+    for (uint32_t v = 0; v <= VMAX; v++) {
+        for (uint32_t c = 0; c <= 40; c++) {
+            uint32_t eax = 0xAAAAAA00u, ecx = 0xBBBBBB00u, esi = 0;
+            (void)esi;
+            SEED;
+            ecx |= c;
+            STMT;
+            uint32_t got = (uint32_t)(GOT), want = ref(LEFT, v, c, WIDTH);
+            if (got != want) {
+                printf("FAIL v=0x%X c=%u got=0x%X want=0x%X\n", v, c, got, want);
+                return 1;
+            }
+            if ((eax & KEEPMASK) != (0xAAAAAA00u & KEEPMASK)) {
+                printf("FAIL v=0x%X c=%u clobbered eax=0x%X\n", v, c, eax);
+                return 1;
+            }
+        }
+    }
+    printf("OK\n");
+    return 0;
+}
+"""
+
+CASES = {
+    "al": (Operand(type="reg", reg="al"), "eax = (eax & 0xFFFFFF00u) | v", "LO8(eax)", 8, 0xFF, "0xFFFFFF00u"),
+    "ah": (Operand(type="reg", reg="ah"), "eax = (eax & 0xFFFF00FFu) | (v << 8)", "HI8(eax)", 8, 0xFF, "0xFFFF00FFu"),
+    "ax": (Operand(type="reg", reg="ax"), "eax = (eax & 0xFFFF0000u) | v", "LO16(eax)", 16, 0x3FF, "0xFFFF0000u"),
+    "byte [esi]": (Operand(type="mem", mem_base="esi", mem_size=1), "MEM8(0) = (uint8_t)v", "MEM8(0)", 8, 0xFF, "0u"),
+}
+
+
+def _find_cc():
+    return shutil.which("clang") or shutil.which("gcc") or shutil.which("cc")
+
+
+class RotateWidthTest(unittest.TestCase):
+    def setUp(self):
+        if not _find_cc():
+            self.skipTest("no C compiler on PATH")
+
+    def _run(self, name, m, stmt):
+        _, seed, got, width, vmax, keep = CASES[name]
+        src = PRELUDE + (BODY.replace("SEED", seed).replace("STMT", stmt.rstrip(";"))
+                         .replace("GOT", got).replace("WIDTH", str(width))
+                         .replace("LEFT", "1" if m == "rol" else "0")
+                         .replace("VMAX", str(vmax)).replace("KEEPMASK", keep))
+        with tempfile.TemporaryDirectory() as tmp:
+            c = os.path.join(tmp, "t.c")
+            with open(c, "w") as f:
+                f.write(src)
+            exe = os.path.join(tmp, "t.exe")
+            r = subprocess.run([_find_cc(), "-w", "-O2", c, "-o", exe], capture_output=True, text=True)
+            self.assertEqual(r.returncode, 0, r.stderr[-1500:])
+            r = subprocess.run([exe], capture_output=True, text=True)
+            return r.returncode, r.stdout + r.stderr
+
+    def test_rotates_match_x86_at_narrow_widths(self):
+        cl = Operand(type="reg", reg="cl")
+        for m in ("rol", "ror"):
+            for name, (dst, *_r) in CASES.items():
+                with self.subTest(op=m, operand=name):
+                    rc, out = self._run(name, m, _rot(m, dst, cl))
+                    self.assertEqual(rc, 0, out)
+                    self.assertTrue(out.startswith("OK"), out)
+
+    def test_pre_fix_expression_is_rejected(self):
+        cl = Operand(type="reg", reg="cl")
+        for m in ("rol", "ror"):
+            for name in ("al", "ah", "byte [esi]"):
+                with self.subTest(op=m, operand=name):
+                    dst = CASES[name][0]
+                    rc, out = self._run(name, m, _legacy(m, dst, cl))
+                    self.assertNotEqual(rc, 0, f"the old expression passed: {out}")
+
+    def test_rol_cl_1_on_0xC0(self):
+        """The measured case: fxam's zero (C3) after shl/sar is 0xC0; rol 1 is 0x81."""
+        stmt = _rot("rol", Operand(type="reg", reg="cl"), Operand(type="imm", imm=1))
+        src = PRELUDE + ("int main(void){ uint32_t ecx = 0x123456C0u; " + stmt +
+                         " printf(\"%08X\\n\", ecx); return 0; }")
+        with tempfile.TemporaryDirectory() as tmp:
+            c = os.path.join(tmp, "t.c")
+            with open(c, "w") as f:
+                f.write(src)
+            exe = os.path.join(tmp, "t.exe")
+            r = subprocess.run([_find_cc(), "-w", c, "-o", exe], capture_output=True, text=True)
+            self.assertEqual(r.returncode, 0, r.stderr)
+            self.assertEqual(subprocess.run([exe], capture_output=True, text=True).stdout.strip(),
+                             "12345681")
+
+
+if __name__ == "__main__":
+    unittest.main()
