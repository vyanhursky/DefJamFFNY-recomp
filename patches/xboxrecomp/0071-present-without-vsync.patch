diff --git a/src/d3d/d3d8_device.c b/src/d3d/d3d8_device.c
index b3c5590..d0f07ea 100644
--- a/src/d3d/d3d8_device.c
+++ b/src/d3d/d3d8_device.c
@@ -128,15 +128,17 @@ static HRESULT d3d8_present(void)
         return hr;
     }
     {
-        /* RECOMP_PRESENT_VSYNC=0: no wait for the host's vertical blank. When
-         * this presents a push buffer's flips a wait here is a wait in the GPU
-         * executor, and without it the executor presents twice as often -- but
-         * Def Jam's intro movie then stalled in 2 start-ups of 4 (0 of 3 with
