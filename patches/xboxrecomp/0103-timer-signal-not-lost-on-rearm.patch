@@ -2990,6 +2990,15 @@ static void kernel_set_timer(uint32_t timer_va, long long due_100ns,
     }
 
     EnterCriticalSection(&g_timer_lock);
+    /* A freshly set timer starts unsignaled, like the real KeSetTimer. Before
