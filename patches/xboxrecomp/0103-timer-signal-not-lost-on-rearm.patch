         break;
     }
-    if (h) {
+    if (h)
         ke_shadow_insert(guest_va, h);
+    LeaveCriticalSection(&g_ke_shadow_cs);
+    if (h) {
         if (s_logged++ < 8)
             fprintf(stderr, "  [KERNEL] lazy shadow: guest object VA=0x%08X type=%u signal=%d\n",
                     guest_va, type, (int)BRIDGE_MEM32(guest_va + 4));
