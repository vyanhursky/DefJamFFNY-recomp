@@ -71,6 +72,30 @@ def write_if_changed(path, text):
     return True
 
 
+# `add esp, N` only; `esp += N; return;` is a `ret N`, the callee's own.
+_CALLER_CLEANUP_RE = re.compile(r"^esp = esp \+ (0x[0-9A-Fa-f]+|\d+);")
+
+
+def _mark_caller_cleans_icalls(lines):
+    """An indirect call whose next statement is `esp = esp + N` (the caller's
+    own cleanup: cdecl) uses RECOMP_ICALL_SAFE_CC, which on a skipped call pops
+    only the return address. The plain macro resets esp to before the
+    arguments -- right for a callee that pops them (stdcall, thiscall), four
+    bytes short of right when the caller then removes them itself."""
+    out = list(lines)
+    for i, line in enumerate(out):
+        if "RECOMP_ICALL_SAFE(_icall_target" not in line:
+            continue
+        for k in range(i + 1, min(i + 8, len(out))):
+            s = out[k].strip()
+            if not s or s == "}" or s.startswith("/*") or s.endswith(": ;"):
+                continue
+            if _CALLER_CLEANUP_RE.match(s):
+                out[i] = line.replace("RECOMP_ICALL_SAFE(", "RECOMP_ICALL_SAFE_CC(")
+            break
+    return out
+
+
