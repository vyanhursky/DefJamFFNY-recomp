+/**
+ * RECOMP_ICALL_SAFE_CC - the same, at a call site whose caller cleans up
+ * (the next instruction is `add esp, N`: cdecl). A skipped call then pops
+ * only the return address, as a callee's `ret` would; resetting esp to before
+ * the arguments, as above, left the caller's own cleanup to remove four bytes
+ * too many, and every later pop read the wrong slot -- Direct3D's PTIMER
+ * handler in Def Jam got its return address back as its object pointer after
+ * a skipped null callback, and faulted.
+ */
+#define RECOMP_ICALL_SAFE_CC(xbox_va, saved_esp) do { \
+    uint32_t _va = (uint32_t)(xbox_va); \
+    (void)(saved_esp); \
+    g_icall_trace[g_icall_trace_idx & (ICALL_TRACE_SIZE-1)] = _va; \
+    g_icall_trace_idx++; \
+    g_icall_count++; \
+    if (!RECOMP_ICALL_IS_CODE(_va)) { \
+        recomp_icall_not_code_log(_va); \
+        g_esp += 4; eax = 0; break; \
+    } \
+    recomp_func_t _fn = recomp_lookup_manual(_va); \
+    if (!_fn) _fn = recomp_lookup(_va); \
+    if (!_fn) _fn = recomp_lookup_kernel(_va); \
+    if (_fn) { RECOMP_ICALL_OBSERVE(_va, RECOMP_ICALL_SEEN_RESOLVED); \
+               RECOMP_ABI_CALL(_va, _fn); } \
+    else { RECOMP_ICALL_OBSERVE(_va, RECOMP_ICALL_SEEN_UNRESOLVED); \
+           recomp_icall_fail_log(_va); g_esp += 4; eax = 0; } \
+} while(0)
