diff --git a/tools/recomp/test_icall_caller_cleans.py b/tools/recomp/test_icall_caller_cleans.py
new file mode 100644
index 0000000..4a7fd22
--- /dev/null
+++ b/tools/recomp/test_icall_caller_cleans.py
@@ -0,0 +1,41 @@
+"""An indirect call followed by the caller's own `add esp, N` gets the macro
+whose skip pops only the return address."""
+from tools.recomp.translator import _mark_caller_cleans_icalls
+
+
+def test_cdecl_site_is_marked():
+    lines = [
+        "    { uint32_t _icall_esp = g_esp;",
+        "    PUSH32(esp, ecx);",
+        "    { uint32_t _icall_target = eax; PUSH32(esp, 0x0022369Bu); "
+        "RECOMP_ICALL_SAFE(_icall_target, _icall_esp); } /* indirect call */",
+        "    }",
+        "",
+        "loc_0022369B: ;",
+        "    esp = esp + 4;",
+    ]
+    out = _mark_caller_cleans_icalls(lines)
+    assert "RECOMP_ICALL_SAFE_CC(_icall_target" in out[2], out[2]
+
+
+def test_callee_cleans_site_is_left_alone():
+    lines = [
+        "    { uint32_t _icall_target = MEM32(eax); PUSH32(esp, 0x0012C39Bu); "
+        "RECOMP_ICALL_SAFE(_icall_target, _icall_esp); } /* indirect call */",
+        "loc_0012C39B: ;",
+        "    ecx = 0; /* xor self */",
+        "    esp = esp + 0x14;",
+    ]
+    out = _mark_caller_cleans_icalls(lines)
+    assert "RECOMP_ICALL_SAFE(" in out[0] and "_CC" not in out[0], out[0]
+
+
+def test_call_then_ret_is_left_alone():
+    lines = [
+        "    { uint32_t _icall_target = eax; PUSH32(esp, 0x00100010u); "
+        "RECOMP_ICALL_SAFE(_icall_target, _icall_esp); } /* indirect call */",
+        "loc_00100010: ;",
+        "    esp += 8; return; /* ret 4 */",
+    ]
+    out = _mark_caller_cleans_icalls(lines)
+    assert "_CC" not in out[0], out[0]
