+# Flag setters whose conditions re-read the destination for its result.
+_RESULT_FLAG_SETTERS = frozenset({
+    "sub", "add", "and", "or", "xor", "inc", "dec", "neg", "shl", "shr", "sar",
+    "imul", "adc", "sbb", "shld", "shrd", "rol", "ror", "rcl", "rcr", "xadd",
+})
+
+_REG_FAMILY = {}
+for _fam, _names in {
+        "a": ("eax", "ax", "al", "ah"), "b": ("ebx", "bx", "bl", "bh"),
+        "c": ("ecx", "cx", "cl", "ch"), "d": ("edx", "dx", "dl", "dh"),
+        "si": ("esi", "si"), "di": ("edi", "di"),
+        "bp": ("ebp", "bp"), "sp": ("esp", "sp")}.items():
+    for _n in _names:
+        _REG_FAMILY[_n] = _fam
+
+# Registers an instruction writes without naming them as its first operand.
+_IMPLICIT_WRITES = {
+    "call": ("a", "c", "d"), "cdq": ("d",), "cwd": ("d",), "cwde": ("a",),
+    "cbw": ("a",), "lahf": ("a",), "leave": ("bp", "sp"), "popal": ("a", "b", "c", "d", "si", "di", "bp"),
+    "fnstsw": ("a",), "fstsw": ("a",),
+}
+# First operand is read, not written.
+_READS_FIRST_OPERAND = frozenset({"push", "call", "jmp", "ret", "fld", "fild",
+                                  "fcom", "fcomp", "fadd", "fsub", "fmul", "fdiv"})
+
+
+def _may_overwrite(insn, op):
+    """Can this (flag-preserving) instruction change what `op` reads?
+    Errs towards yes: a needless save costs one assignment."""
+    m = insn.mnemonic
+    if op.type == "mem":
+        return True                 # stores, pushes, a moved base register...
+    if op.type != "reg":
+        return False
+    fam = _REG_FAMILY.get(str(op.reg).lower())
+    if fam is None:
+        return False
+    if m.startswith("rep") or m in ("movsb", "movsw", "movsd", "stosb", "stosw",
+                                    "stosd", "lodsb", "lodsw", "lodsd"):
+        return fam in ("a", "c", "si", "di")
+    if fam in _IMPLICIT_WRITES.get(m, ()):
+        return True
+    if m == "xchg":
+        return any(o.type == "reg" and _REG_FAMILY.get(str(o.reg).lower()) == fam
+                   for o in insn.operands)
+    if m in _READS_FIRST_OPERAND or m.startswith("j") or not insn.operands:
+        return False
+    o = insn.operands[0]
+    return o.type == "reg" and _REG_FAMILY.get(str(o.reg).lower()) == fam
+
