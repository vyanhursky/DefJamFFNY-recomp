+/* Texture stages 1-3 (M4f), decoded from the registers the title last set
+ * for them (s_tex_reg) exactly as stage 0 is decoded as its methods arrive,
+ * and bound through the same path by standing each in for stage 0 for the
+ * length of the bind. Only the GPU vertex path hands the pixel side texture
+ * coordinates 1-3, so the CPU path empties those stages instead. */
+static void bind_extra_stages(int with_coords)
+{
+    int st;
+    for (st = 1; st < 4; st++) {
+        uint32_t k = (uint32_t)st * 16;       /* 0x40 bytes per stage, in words */
+        Texture t;
+        uint32_t fmt, rect, ctl0, ctl1, pal, adr;
+        memset(&t, 0, sizeof t);
+        if (with_coords && s_tex_set[k] && s_tex_set[k + 1] && s_tex_set[k + 3]) {
+            fmt  = s_tex_reg[k + 1];
+            adr  = s_tex_reg[k + 2];
+            ctl0 = s_tex_reg[k + 3];
+            ctl1 = s_tex_reg[k + 4];
+            rect = s_tex_reg[k + 7];
+            pal  = s_tex_reg[k + 8];
+            t.offset = dma_resolve(s_tex_reg[k]);
+            t.color = (fmt >> 8) & 0xFF;
+            if (tex_size_from_format(t.color)) {
+                t.width  = 1u << ((fmt >> 20) & 0xF);
+                t.height = 1u << ((fmt >> 24) & 0xF);
+            } else {
+                t.width  = rect >> 16;
+                t.height = rect & 0xFFFF;
+            }
+            t.pitch = ctl1 >> 16;
+            t.addr_u = adr & 0xF;
+            t.addr_v = (adr >> 8) & 0xF;
+            if (s_tex_set[k + 8]) {
+                t.palette = dma_resolve(pal & ~0x3Fu);
+                t.palette_len = 256u >> ((pal >> 2) & 3);
+            }
+            t.disabled = !(ctl0 & (1u << 30));
+            t.valid = t.offset && t.width && t.height
+                   && (tex_size_from_format(t.color) || t.pitch) && !t.disabled;
+        }
+        if (t.valid) {
+            Texture keep = s_gpu.tex;
+            s_gpu.tex = t;
+            pgraph_d3d11_bind_stage(st);
+            bind_texture_ready();
+            pgraph_d3d11_set_texture_address(t.addr_u, t.addr_v);
+            s_gpu.tex = keep;
+            pgraph_d3d11_bind_stage(0);
+        } else {
+            pgraph_d3d11_unbind_stage(st);
+        }
+    }
+}
