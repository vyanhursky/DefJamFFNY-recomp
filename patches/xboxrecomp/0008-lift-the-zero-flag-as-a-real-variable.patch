+            expr = f"(({dst}) >> 1) | (_cf ? 0x{top:X}u : 0u)"
+            newcf = f"(int)(({dst}) & 1u)"
+        else:
+            expr = f"(({dst}) << 1) | (_cf ? 1u : 0u)"
+            newcf = f"(int)((({dst}) >> {bits - 1}) & 1u)"
+        return [
+            "{ int _rc_cf = " + newcf + ";",
+            "  " + _fmt_operand_write(ops[0], expr),
+            f"  _cf = _rc_cf; }}  /* {m} {insn.op_str} */",
+        ]
