+    def _lift_rotate_carry(self, insn, ops, m):
+        """rcl/rcr: rotate through the carry flag.
+
+        The carry is part of the value, which is what separates these from
+        rol/ror: an N-bit register rotates as an (N+1)-bit quantity with CF on
+        the end. That is why the CRT's 64-bit divide uses them -- `shr ebx,1 /
+        rcr ecx,1` shifts a 64-bit pair right one bit, carrying between the
+        halves.
+
+        Dropping them, which is what happened before, is silent and wrong in
+        the worst way: the shift still happens on one half and the bit that
+        should have crossed disappears. _alldiv, _aulldiv, _allrem and _aullrem
+        all take that path when the divisor does not fit in 32 bits, and so
+        does one site in this title's own code.
+
+        Only a count of 1 is emitted, because that is the whole of what x86
+        code in practice uses here and a general count needs a modulo (N+1)
+        rotate that would obscure the common case. Anything else still records
+        itself as unimplemented rather than pretending.
+        """
+        if len(ops) < 2:
+            return [f"/* {m}: bad operands */"]
+        if not (ops[1].type == "imm" and ops[1].imm == 1):
+            self.unimplemented.setdefault(m, []).append(insn.address)
+            return [f"/* TODO: {m} {insn.op_str} (count is not 1) */"]
+
