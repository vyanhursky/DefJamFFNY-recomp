-    return sample_count;
+
+    while (out < requested_num) {
+        float *s0, *s1;
+        if (r->pos + 1 >= r->n) {
+            if (!vrs_fill(d, v, r) || r->pos + 1 >= r->n) {
+                /* Out of source: play the last sample out once, then stop. */
+                if (r->pos < r->n) {
+                    samples[out][0] = r->buf[r->pos][0];
+                    samples[out][1] = r->buf[r->pos][1];
+                    out++;
