+        samples[out][0] = s0[0] + (float)((s1[0] - s0[0]) * r->frac);
+        samples[out][1] = s0[1] + (float)((s1[1] - s0[1]) * r->frac);
+        out++;
+        r->frac += step;
+        while (r->frac >= 1.0) {
+            r->frac -= 1.0;
+            r->pos++;
+        }
+    }
+    return out > 0 ? out : -1;
 }
 
