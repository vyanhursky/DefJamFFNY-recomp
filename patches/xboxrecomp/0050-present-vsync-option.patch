diff --git a/src/d3d/d3d8_device.c b/src/d3d/d3d8_device.c
index 4272895..b3c5590 100644
--- a/src/d3d/d3d8_device.c
+++ b/src/d3d/d3d8_device.c
@@ -127,7 +127,19 @@ static HRESULT d3d8_present(void)
         fprintf(stderr, "D3D8: Gamma presentation failed: 0x%08lX\n", hr);
         return hr;
     }
-    hr = IDXGISwapChain_Present(g_device_state.swap_chain, 1, 0);
+    {
+        /* RECOMP_PRESENT_VSYNC=0: no wait for the host's vertical blank. When
+         * this presents a push buffer's flips a wait here is a wait in the GPU
+         * executor, and without it the executor presents twice as often -- but
+         * Def Jam's intro movie then stalled in 2 start-ups of 4 (0 of 3 with
+         * the wait), so the wait stays the default. */
+        static int vsync = -1;
+        if (vsync < 0) {
+            const char *e = getenv("RECOMP_PRESENT_VSYNC");
+            vsync = (e && *e == '0') ? 0 : 1;
+        }
+        hr = IDXGISwapChain_Present(g_device_state.swap_chain, (UINT)vsync, 0);
+    }
     d3d8_gamma_end(g_device_state.default_rtv);
     return hr;
 }
