+    def _lift_rep_compare(self, m, is_cmps, width):
+        """repe/repne cmps* and scas*, publishing every flag a cmp would.
+
+        Only equality used to come out, in _flags. But MSVC's inline memcmp is
+
+            repe cmpsb ; je equal ; sbb eax, eax ; sbb eax, -1
+
+        and the sbb pair turns the carry of the last compared pair into -1 or
+        +1. With _cf never written, every ordered compare returned the same
+        sign whatever the bytes were -- 659 sites in 85 functions of this
+        title. The last pair compared is snapshotted exactly as a cmp would
+        (_fa/_fb, _fas/_fbs, _fcmp), so a magnitude branch at a block boundary
+        reads it too.
+
+        With ecx == 0 the hardware compares nothing and leaves the flags alone,
+        so the snapshot is only taken when the loop ran; _flags then mirrors the
+        ZF that was already there instead of a stale earlier compare.
+        """
+        acc = {1: "MEM8", 2: "MEM16", 4: "MEM32"}[width]
+        stype = {1: "int8_t", 2: "int16_t", 4: "int32_t"}[width]
+        mask = {1: "0xFFu", 2: "0xFFFFu", 4: "0xFFFFFFFFu"}[width]
+        sign = width * 8 - 1
+        if is_cmps:
+            lhs = f"{acc}(esi)"
+            advance = "esi += _st; edi += _st; ecx--;"
+        else:
+            lhs = {1: "LO8(eax)", 2: "LO16(eax)", 4: "eax"}[width]
+            advance = "edi += _st; ecx--;"
+        continue_on_equal = "repne" not in m and "repnz" not in m
+        stop = "(_ra != _rb)" if continue_on_equal else "(_ra == _rb)"
+        carry = " _cf = (int)(_fa < _fb);" if self.needs_cf else ""
+        return [
+            f"{{ int32_t _st = RECOMP_DF_STEP({width}); uint32_t _ra = 0, _rb = 0; int _ran = 0;",
+            "while (ecx != 0) {",
+            f"    _ra = (uint32_t)({lhs}) & {mask}; _rb = (uint32_t)({acc}(edi)) & {mask}; _ran = 1;",
+            f"    {advance}",
+            f"    if {stop} break;",
+            "}",
+            "if (_ran) {",
+            f"    _fa = _ra; _fb = _rb; _fas = (int32_t)({stype})_fa; _fbs = (int32_t)({stype})_fb;",
+            f"    _zf = (int)(_fa == _fb); _fcmp = 1; _sf = (int)((((_fa - _fb) & {mask}) >> {sign}) & 1);",
+            f"    _of = (int)((((_fa ^ _fb) & (_fa ^ (_fa - _fb))) >> {sign}) & 1);{carry}",
+            "}",
+            f"_flags = _zf; }} /* {m} */",
+        ]
+
