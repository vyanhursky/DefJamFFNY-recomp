+def _compare(mnemonic, size, raw):
+    insn = Instruction(0, 2, mnemonic, "[esi], es:[edi]", raw)
+    insn.operands = [
+        Operand(type="mem", mem_base="esi", mem_size=size),
+        Operand(type="mem", mem_base="edi", mem_size=size),
+    ]
+    return insn
+
+
+def _jump(mnemonic, address=2, target=0x10):
+    jump = Instruction(address, 2, mnemonic, hex(target), "7400")
+    jump.jump_target = target
+    return jump
+
+
+def _lifter(needs_cf=False):
+    lifter = Lifter()
+    lifter.func_start = 0
+    lifter.func_end = 0x20
+    lifter.needs_cf = needs_cf
+    return lifter
+
+
