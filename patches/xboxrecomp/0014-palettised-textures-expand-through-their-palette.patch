-                                                   mem + s_gpu.tex.offset,
-                                                   s_gpu.tex.width,
-                                                   s_gpu.tex.height,
-                                                   s_gpu.tex.color);
+                    bind_texture_ready();
                 } else {
                     pgraph_d3d11_set_texture_ready(0, NULL, 0, 0, 0);
                 }
@@ -1835,6 +1909,15 @@ void nv2a_pb_exec_method(uint32_t subch, uint32_t method, uint32_t param)
         record_tex_reg(method, param);
         break;
 
+    case NV097_SET_TEXTURE_PALETTE:
+        /* Bit 0 picks context DMA A or B, bits 3:2 the length (256 >> n
+         * entries), bits 31:6 the offset -- a DMA offset like every other,
+         * resolved the same way. */
+        s_gpu.tex.palette     = dma_resolve(param & ~0x3Fu);
+        s_gpu.tex.palette_len = 256u >> ((param >> 2) & 3);
+        record_tex_reg(method, param);
+        break;
+
     default:
         if (method >= NV_TEX_FIRST && method <= NV_TEX_LAST)
             record_tex_reg(method, param);
