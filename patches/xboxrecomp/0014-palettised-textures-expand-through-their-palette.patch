+/* Hand the bound texture to the translator, expanding palettised ones.
+ *
+ * SZ_I8_A8R8G8B8 is an 8-bit index per texel into a palette of ARGB entries
+ * the title points at with SET_TEXTURE_PALETTE. The translator's D3D8 layer
+ * knows the format only as P8 with a palette of its own, which defaults to a
+ * grey ramp -- so an indexed texture came out as grey noise, which is how the
+ * first screen after this title's loading screen looked. The expansion is
+ * done here, where the palette address is known: unswizzle the indices,
+ * look each one up, and send linear ARGB.
+ *
+ * The translator caches an upload by (address, format, size), so the key it
+ * is given folds in the palette address, and the expansion itself is skipped
+ * for a key already sent -- a menu binds the same texture hundreds of times a
+ * frame.
+ *
+ * ponytail: a palette rewritten in place under the same address is not
+ * noticed; a title that animates by cycling a palette will show the first. */
+static void bind_texture_ready(void)
+{
+    const uint8_t *mem = (const uint8_t *)xbox_GetMemoryOffset();
+    uint32_t w = s_gpu.tex.width, h = s_gpu.tex.height;
+    enum { SEEN_MAX = 64 };
+    static uint32_t seen[SEEN_MAX];
+    static int seen_count;
+    uint32_t key, *argb;
+    uint8_t *idx;
+    const uint32_t *pal;
+    uint32_t i, n;
+
+    if (s_gpu.tex.color != NV097_TEXFMT_SZ_I8_A8R8G8B8 || !s_gpu.tex.palette
+            || !w || !h || w > 4096 || h > 4096) {
+        pgraph_d3d11_set_texture_ready(s_gpu.tex.offset, mem + s_gpu.tex.offset,
+                                       w, h, s_gpu.tex.color);
+        return;
+    }
+
+    key = s_gpu.tex.offset ^ (s_gpu.tex.palette * 2654435761u);
+    for (i = 0; i < (uint32_t)seen_count; i++) {
+        if (seen[i] == key) {
+            /* Already uploaded under this key; the translator will not read
+             * the data, only look the key up. */
+            pgraph_d3d11_set_texture_ready(key, mem + s_gpu.tex.offset, w, h,
+                                           NV097_TEXFMT_LU_IMAGE_A8R8G8B8);
+            return;
+        }
+    }
+
+    n = w * h;
+    idx = (uint8_t *)malloc(n);
+    argb = (uint32_t *)malloc((size_t)n * 4);
+    if (!idx || !argb) {
+        free(idx); free(argb);
+        pgraph_d3d11_set_texture_ready(0, NULL, 0, 0, 0);
+        return;
+    }
+    xbox_unswizzle_rect(idx, mem + s_gpu.tex.offset, w, h, 1);
+    pal = (const uint32_t *)(mem + s_gpu.tex.palette);
+    for (i = 0; i < n; i++)
+        argb[i] = idx[i] < s_gpu.tex.palette_len ? pal[idx[i]] : 0;
+    pgraph_d3d11_set_texture_ready(key, argb, w, h, NV097_TEXFMT_LU_IMAGE_A8R8G8B8);
+    free(idx);
+    free(argb);
+
+    if (seen_count < SEEN_MAX)
+        seen[seen_count++] = key;
+    {
+        static int shown;
+        if (shown++ < 8)
+            fprintf(stderr, "  [GPU] palettised texture 0x%08X %ux%u expanded "
+                            "through palette 0x%08X (%u entries)\n",
+                    s_gpu.tex.offset, w, h, s_gpu.tex.palette, s_gpu.tex.palette_len);
+    }
+}
