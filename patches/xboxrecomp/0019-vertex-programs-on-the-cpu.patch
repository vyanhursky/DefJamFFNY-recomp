diff --git a/src/kernel/nv2a_vsh_cpu.c b/src/kernel/nv2a_vsh_cpu.c
new file mode 100644
index 0000000..d59894b
--- /dev/null
+++ b/src/kernel/nv2a_vsh_cpu.c
@@ -0,0 +1,410 @@
+/*
+ * NV2A vertex programs, run on the CPU.
+ *
+ * A title with its Direct3D linked in drives the transform unit through the
+ * push buffer: it switches it to program mode (SET_TRANSFORM_EXECUTION_MODE),
+ * uploads microcode (SET_TRANSFORM_PROGRAM, four dwords an instruction) and
+ * constants (SET_TRANSFORM_CONSTANT, four floats a register), and draws. The
+ * positions it hands over are whatever the program expects -- Def Jam's front
+ * end sends stage coordinates, x -2..553 for the legal screen -- and only the
+ * program turns them into pixels. Drawn as pixels, every screen landed in the
+ * top-left at the wrong scale.
+ *
+ * Direct3D ends every program with the same epilogue, which is what makes a
+ * CPU run enough here: it scales by the viewport and divides by w itself
+ * (`MAD oPos.xyz, R12, R1.x, c[59]` after `RCC R1.x, R12.w`), so oPos comes
+ * out in screen pixels and needs nothing further.
+ *
+ * The encoding and the semantics follow xemu's vsh.c (and Cxbx-Reloaded's
+ * field table), checked against an instruction this title uploads: dwords
+ * 1..3 carry the fields, dword 0 is unused. The toolkit's d3d8_vsh.c decodes
+ * a different layout and does not read this title's microcode correctly, so
+ * it is not reused.
+ *
+ * ponytail: one vertex at a time, no caching of decoded instructions, and only
+ * oPos, oD0 and oT0 are handed on. Enough for a front end; a 3D scene with
+ * thousands of vertices a frame wants the decode cached, and multitexture
+ * wants the other outputs.
+ */
+
+#include <math.h>
+#include <float.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "nv2a_vsh_cpu.h"
+
+#define VSH_SLOTS      136
+#define VSH_CONSTS     192
+
+#define M_SET_TRANSFORM_PROGRAM        0x0B00   /* 32 dwords */
+#define M_SET_TRANSFORM_CONSTANT       0x0B80   /* 32 dwords */
+#define M_SET_TRANSFORM_EXECUTION_MODE 0x1E94
+#define M_SET_TRANSFORM_PROGRAM_LOAD   0x1E9C
+#define M_SET_TRANSFORM_PROGRAM_START  0x1EA0
+#define M_SET_TRANSFORM_CONSTANT_LOAD  0x1EA4
+#define M_SET_VIEWPORT_OFFSET          0x0A20   /* 4 floats  */
+#define M_SET_VIEWPORT_SCALE           0x0AF0   /* 4 floats  */
+#define M_SET_VERTEX_DATA2F_M          0x1880   /* + attr*8  */
+#define M_SET_VERTEX_DATA4UB           0x1940   /* + attr*4  */
+#define M_SET_VERTEX_DATA4F_M          0x1A00   /* + attr*16 */
+
+static uint32_t s_prog[VSH_SLOTS][4];
+static float    s_const[VSH_CONSTS][4];
+static uint32_t s_prog_load, s_prog_start, s_const_load;
+static int      s_mode_program, s_loaded;
+/* Each attribute's current value: what a program reads from an input no
+ * array feeds. */
+static float    s_current[16][4];
+static int      s_current_init;
+static int      s_trace_left;      /* vertex runs still to trace */
+
+void nv2a_vsh_trace(int runs)
+{
+    s_trace_left = runs;
+}
+
+static void current_init(void)
+{
+    int a;
+    if (s_current_init)
+        return;
+    for (a = 0; a < 16; a++) {
+        s_current[a][0] = s_current[a][1] = s_current[a][2] = 0.0f;
+        s_current[a][3] = 1.0f;
+    }
+    /* Colours default to opaque white, as Direct3D's do: a program that
+     * modulates by an unfed diffuse would otherwise draw everything black. */
+    for (a = 3; a <= 4; a++)
+        s_current[a][0] = s_current[a][1] = s_current[a][2] = 1.0f;
+    s_current_init = 1;
+}
+
+static float as_float(uint32_t u)
+{
+    float f;
+    memcpy(&f, &u, 4);
+    return f;
+}
+
+int nv2a_vsh_method(uint32_t method, uint32_t param)
+{
+    current_init();
+    if (method >= M_SET_TRANSFORM_PROGRAM && method < M_SET_TRANSFORM_PROGRAM + 0x80) {
+        uint32_t slot = (method - M_SET_TRANSFORM_PROGRAM) / 4;
+        if (s_prog_load < VSH_SLOTS)
+            s_prog[s_prog_load][slot % 4] = param;
+        if (slot % 4 == 3)
+            s_prog_load++;
+        s_loaded = 1;
+        return 1;
+    }
+    if (method >= M_SET_TRANSFORM_CONSTANT && method < M_SET_TRANSFORM_CONSTANT + 0x80) {
+        uint32_t slot = (method - M_SET_TRANSFORM_CONSTANT) / 4;
+        if (s_const_load < VSH_CONSTS)
+            s_const[s_const_load][slot % 4] = as_float(param);
+        if (slot % 4 == 3) {
+            static int trace = -1, seen[VSH_CONSTS];
+            if (trace < 0)
+                trace = getenv("RECOMP_VSH_TRACE") != NULL;
+            if (trace && s_const_load < VSH_CONSTS && seen[s_const_load]++ < 2)
+                fprintf(stderr, "[VSH] c[%u] = %g %g %g %g\n", s_const_load,
+                        s_const[s_const_load][0], s_const[s_const_load][1],
+                        s_const[s_const_load][2], s_const[s_const_load][3]);
+            s_const_load++;
+        }
+        return 1;
+    }
+    /* The viewport registers are transform constants too: scale is c[58] and
+     * offset c[59], which is where Direct3D's epilogue reads them (xemu's
+     * NV_IGRAPH_XF_XFCTX_VPSCL/VPOFF). The title never loads those slots
+     * itself, and without the mirror every position came out as 0,0. */
+    if (method >= M_SET_VIEWPORT_SCALE && method < M_SET_VIEWPORT_SCALE + 16) {
+        s_const[58][(method - M_SET_VIEWPORT_SCALE) / 4] = as_float(param);
+        return 1;
+    }
+    if (method >= M_SET_VIEWPORT_OFFSET && method < M_SET_VIEWPORT_OFFSET + 16) {
+        s_const[59][(method - M_SET_VIEWPORT_OFFSET) / 4] = as_float(param);
+        return 1;
+    }
+    switch (method) {
+    case M_SET_TRANSFORM_EXECUTION_MODE:
+        s_mode_program = (param & 3) == 2;
+        return 1;
+    case M_SET_TRANSFORM_PROGRAM_LOAD:
+        s_prog_load = param;
+        return 1;
+    case M_SET_TRANSFORM_PROGRAM_START:
+        s_prog_start = param;
+        return 1;
+    case M_SET_TRANSFORM_CONSTANT_LOAD:
+        s_const_load = param;
+        return 1;
+    default:
+        break;
+    }
+    if (method >= M_SET_VERTEX_DATA4F_M && method < M_SET_VERTEX_DATA4F_M + 16 * 16) {
+        uint32_t off = method - M_SET_VERTEX_DATA4F_M;
+        s_current[off / 16][(off % 16) / 4] = as_float(param);
+    } else if (method >= M_SET_VERTEX_DATA2F_M && method < M_SET_VERTEX_DATA2F_M + 16 * 8) {
+        uint32_t off = method - M_SET_VERTEX_DATA2F_M;
+        s_current[off / 8][(off % 8) / 4] = as_float(param);
+    } else if (method >= M_SET_VERTEX_DATA4UB && method < M_SET_VERTEX_DATA4UB + 16 * 4) {
+        /* A D3DCOLOR, read the way the array fetch reads one: R, G, B, A. */
+        float *c = s_current[(method - M_SET_VERTEX_DATA4UB) / 4];
+        c[0] = (float)((param >> 16) & 0xFF) / 255.0f;
+        c[1] = (float)((param >>  8) & 0xFF) / 255.0f;
+        c[2] = (float)( param        & 0xFF) / 255.0f;
+        c[3] = (float)( param >> 24        ) / 255.0f;
+    }
+    return 0;
+}
+
+int nv2a_vsh_active(void)
+{
+    return s_mode_program && s_loaded;
+}
+
+void nv2a_vsh_current(int attr, float out[4])
+{
+    current_init();
+    memcpy(out, s_current[attr & 15], sizeof(float) * 4);
+}
+
+/* A field of a 128-bit instruction: dword `w`, bit `pos`, `n` bits. */
+#define F(ins, w, pos, n) (((ins)[w] >> (pos)) & ((1u << (n)) - 1u))
+
+enum { MUX_R = 1, MUX_V = 2, MUX_C = 3 };
+enum { MAC_NOP, MAC_MOV, MAC_MUL, MAC_ADD, MAC_MAD, MAC_DP3, MAC_DPH, MAC_DP4,
+       MAC_DST, MAC_MIN, MAC_MAX, MAC_SLT, MAC_SGE, MAC_ARL };
+enum { ILU_NOP, ILU_MOV, ILU_RCP, ILU_RCC, ILU_RSQ, ILU_EXP, ILU_LOG, ILU_LIT };
+
+typedef struct {
+    float R[13][4];          /* R0..R11, and R12 which is oPos */
+    float O[13][4];          /* output registers; O[0] is not used (R12 is) */
+    const float (*v)[4];
+    int   a0;
+} VshState;
+
+static void read_src(const VshState *s, const uint32_t *ins, int which, float out[4])
+{
+    uint32_t mux, reg, neg, sw[4];
+    const float *src;
+    int i;
+
+    if (which == 0) {        /* A */
+        neg = F(ins, 1, 8, 1);
+        sw[0] = F(ins, 1, 6, 2); sw[1] = F(ins, 1, 4, 2);
+        sw[2] = F(ins, 1, 2, 2); sw[3] = F(ins, 1, 0, 2);
+        reg = F(ins, 2, 28, 4);  mux = F(ins, 2, 26, 2);
+    } else if (which == 1) { /* B */
+        neg = F(ins, 2, 25, 1);
+        sw[0] = F(ins, 2, 23, 2); sw[1] = F(ins, 2, 21, 2);
+        sw[2] = F(ins, 2, 19, 2); sw[3] = F(ins, 2, 17, 2);
+        reg = F(ins, 2, 13, 4);   mux = F(ins, 2, 11, 2);
+    } else {                 /* C */
+        neg = F(ins, 2, 10, 1);
+        sw[0] = F(ins, 2, 8, 2); sw[1] = F(ins, 2, 6, 2);
+        sw[2] = F(ins, 2, 4, 2); sw[3] = F(ins, 2, 2, 2);
+        reg = (F(ins, 2, 0, 2) << 2) | F(ins, 3, 30, 2);
+        mux = F(ins, 3, 28, 2);
+    }
+
+    switch (mux) {
+    case MUX_R:
+        src = s->R[reg < 13 ? reg : 0];
+        break;
+    case MUX_V:
+        src = s->v[F(ins, 1, 9, 4)];
+        break;
+    case MUX_C: {
+        int c = (int)F(ins, 1, 13, 8);
+        if (F(ins, 3, 1, 1))
+            c += s->a0;
+        if (c < 0) c = 0;
+        if (c >= VSH_CONSTS) c = VSH_CONSTS - 1;
+        src = s_const[c];
+        break;
+    }
+    default: {
+        static const float zero[4] = { 0, 0, 0, 0 };
+        src = zero;
+        break;
+    }
+    }
+    for (i = 0; i < 4; i++)
+        out[i] = neg ? -src[sw[i]] : src[sw[i]];
+}
+
+static void write_masked(float *dst, const float *val, uint32_t mask)
+{
+    if (mask & 8) dst[0] = val[0];
+    if (mask & 4) dst[1] = val[1];
+    if (mask & 2) dst[2] = val[2];
+    if (mask & 1) dst[3] = val[3];
+}
+
+static void splat(float *r, float v)
+{
+    r[0] = r[1] = r[2] = r[3] = v;
+}
+
+static float dot(const float *a, const float *b, int n)
+{
+    float d = 0.0f;
+    int i;
+    for (i = 0; i < n; i++)
+        d += a[i] * b[i];
+    return d;
+}
+
+int nv2a_vsh_run(const float in[16][4], NvVshOutput *out)
+{
+    VshState s;
+    uint32_t pc;
+
+    if (!nv2a_vsh_active())
+        return 0;
+    memset(&s, 0, sizeof(s));
+    s.v = in;
+    /* Outputs a program leaves alone read as xemu initialises them. */
+    s.O[3][3] = 1.0f;                        /* oD0.a */
+    s.R[12][3] = 1.0f;                       /* oPos.w */
+
+    for (pc = s_prog_start; pc < VSH_SLOTS; pc++) {
+        const uint32_t *ins = s_prog[pc];
+        uint32_t mac = F(ins, 1, 21, 4), ilu = F(ins, 1, 25, 3);
+        uint32_t mac_mask = F(ins, 3, 24, 4), ilu_mask = F(ins, 3, 16, 4);
+        uint32_t out_r = F(ins, 3, 20, 4), o_mask = F(ins, 3, 12, 4);
+        uint32_t orb = F(ins, 3, 11, 1), addr = F(ins, 3, 3, 8);
+        uint32_t o_from_ilu = F(ins, 3, 2, 1);
+        float A[4], B[4], C[4], m[4] = { 0 }, l[4] = { 0 };
+        int i;
+
+        read_src(&s, ins, 0, A);
+        read_src(&s, ins, 1, B);
+        read_src(&s, ins, 2, C);
+
+        /* Both units read before either writes: they run in parallel. */
+        switch (mac) {
+        case MAC_MOV: memcpy(m, A, sizeof(m)); break;
+        case MAC_MUL: for (i = 0; i < 4; i++) m[i] = A[i] * B[i]; break;
+        case MAC_ADD: for (i = 0; i < 4; i++) m[i] = A[i] + C[i]; break;
+        case MAC_MAD: for (i = 0; i < 4; i++) m[i] = A[i] * B[i] + C[i]; break;
+        case MAC_DP3: splat(m, dot(A, B, 3)); break;
+        case MAC_DPH: splat(m, dot(A, B, 3) + B[3]); break;
+        case MAC_DP4: splat(m, dot(A, B, 4)); break;
+        case MAC_DST: m[0] = 1.0f; m[1] = A[1] * B[1]; m[2] = A[2]; m[3] = B[3]; break;
+        case MAC_MIN: for (i = 0; i < 4; i++) m[i] = A[i] < B[i] ? A[i] : B[i]; break;
+        case MAC_MAX: for (i = 0; i < 4; i++) m[i] = A[i] > B[i] ? A[i] : B[i]; break;
+        case MAC_SLT: for (i = 0; i < 4; i++) m[i] = A[i] <  B[i] ? 1.0f : 0.0f; break;
+        case MAC_SGE: for (i = 0; i < 4; i++) m[i] = A[i] >= B[i] ? 1.0f : 0.0f; break;
+        default: break;
+        }
+        switch (ilu) {
+        case ILU_MOV: memcpy(l, C, sizeof(l)); break;
+        case ILU_RCP: splat(l, 1.0f / C[0]); break;
+        case ILU_RCC: {
+            float r = 1.0f / C[0], a = fabsf(r);
+            if (a < 5.42101e-20f) a = 5.42101e-20f;
+            if (a > 1.884467e19f) a = 1.884467e19f;
+            splat(l, r < 0 ? -a : a);
+            break;
+        }
+        case ILU_RSQ: splat(l, 1.0f / sqrtf(fabsf(C[0]))); break;
+        case ILU_EXP: {
+            float f = floorf(C[0]);
+            l[0] = exp2f(f); l[1] = C[0] - f; l[2] = exp2f(C[0]); l[3] = 1.0f;
+            break;
+        }
+        case ILU_LOG: {
+            float t = fabsf(C[0]);
+            if (t == 0.0f) {
+                l[0] = -FLT_MAX; l[1] = 1.0f; l[2] = -FLT_MAX; l[3] = 1.0f;
+            } else {
+                float e = floorf(log2f(t));
+                l[0] = e; l[1] = t / exp2f(e); l[2] = log2f(t); l[3] = 1.0f;
+            }
+            break;
+        }
+        case ILU_LIT: {
+            float p = C[3] < -128.0f ? -128.0f : C[3] > 128.0f ? 128.0f : C[3];
+            l[0] = 1.0f;
+            l[1] = C[0] > 0.0f ? C[0] : 0.0f;
+            l[2] = C[0] > 0.0f ? powf(C[1] > 0.0f ? C[1] : 0.0f, p) : 0.0f;
+            l[3] = 1.0f;
+            break;
+        }
+        default: break;
+        }
+
+        if (mac == MAC_ARL) {
+            s.a0 = (int)floorf(A[0] + 0.001f);
+        } else if (mac != MAC_NOP && mac_mask && out_r < 13) {
+            write_masked(s.R[out_r], m, mac_mask);
+        }
+        /* Paired with a MAC operation, the ILU's temporary is always R1. */
+        if (ilu != ILU_NOP && ilu_mask) {
+            uint32_t r = (mac != MAC_NOP) ? 1 : out_r;
+            if (r < 13)
+                write_masked(s.R[r], l, ilu_mask);
+        }
+        if (o_mask) {
+            const float *val = o_from_ilu ? l : m;
+            if (orb) {                       /* an output register */
+                if (addr == 0)
+                    write_masked(s.R[12], val, o_mask);
+                else if (addr < 13)
+                    write_masked(s.O[addr], val, o_mask);
+            } else if (addr < VSH_CONSTS) {  /* a constant, rare */
+                write_masked(s_const[addr], val, o_mask);
+            }
+        }
+        /* RECOMP_VSH_TRACE=<n>: the first n vertices, step by step; or
+         * whatever nv2a_vsh_trace() armed. */
+        {
+            static int trace = -1;
+            static const float (*last_v)[4];
+            if (trace < 0) {
+                const char *t = getenv("RECOMP_VSH_TRACE");
+                trace = t ? atoi(t) : 0;
+                if (s_trace_left < trace)
+                    s_trace_left = trace;
+            }
+            if (s_trace_left > 0) {
+                int runs_left = s_trace_left;
+                (void)runs_left;
+                if (pc == s_prog_start && last_v != in) {
+                    int a;
+                    last_v = in;
+                    fprintf(stderr, "[VSH] start %u", s_prog_start);
+                    for (a = 0; a < 16; a++)
+                        fprintf(stderr, "  v%d %g %g %g %g", a, in[a][0], in[a][1],
+                                in[a][2], in[a][3]);
+                    fprintf(stderr, "\n[VSH] c0 %g %g %g %g  c1 %g %g %g %g  c3 %g %g %g %g\n",
+                            s_const[0][0], s_const[0][1], s_const[0][2], s_const[0][3],
+                            s_const[1][0], s_const[1][1], s_const[1][2], s_const[1][3],
+                            s_const[3][0], s_const[3][1], s_const[3][2], s_const[3][3]);
+                }
+                fprintf(stderr, "[VSH] %3u %08X %08X %08X %08X mac %u ilu %u"
+                                " -> m %g %g %g %g  l %g %g %g %g  oPos %g %g %g %g\n",
+                        pc, ins[0], ins[1], ins[2], ins[3], mac, ilu,
+                        m[0], m[1], m[2], m[3], l[0], l[1], l[2], l[3],
+                        s.R[12][0], s.R[12][1], s.R[12][2], s.R[12][3]);
+                if (F(ins, 3, 0, 1) || pc + 1 >= VSH_SLOTS) {
+                    s_trace_left--;
+                    last_v = NULL;
+                }
+            }
+        }
+        if (F(ins, 3, 0, 1))
+            break;
+    }
+    if (pc >= VSH_SLOTS)
+        return 0;
+
+    memcpy(out->pos, s.R[12], sizeof(out->pos));
+    memcpy(out->d0, s.O[3], sizeof(out->d0));
+    memcpy(out->t0, s.O[9], sizeof(out->t0));
+    return 1;
+}
diff --git a/src/kernel/nv2a_vsh_cpu.h b/src/kernel/nv2a_vsh_cpu.h
new file mode 100644
index 0000000..f5e74cd
--- /dev/null
+++ b/src/kernel/nv2a_vsh_cpu.h
@@ -0,0 +1,40 @@
+/*
+ * NV2A vertex programs, run on the CPU for the push-buffer executor.
+ *
+ * A title whose Direct3D is linked into the executable does not call a
+ * runtime Direct3D: it uploads vertex programs and constants through the push
+ * buffer and switches the transform unit into program mode. Positions then
+ * arrive in the title's own coordinates, and only running the program puts
+ * them on the screen. See nv2a_vsh_cpu.c.
+ */
+#ifndef XBOXRECOMP_NV2A_VSH_CPU_H
+#define XBOXRECOMP_NV2A_VSH_CPU_H
+
+#include <stdint.h>
+
+/* What one run of the program produced for one vertex. */
+typedef struct {
+    float pos[4];    /* oPos: screen x, y, depth, w, as the program left it */
+    float d0[4];     /* oD0: diffuse, r g b a in 0..1                       */
+    float t0[4];     /* oT0: texture coordinate set 0                       */
+} NvVshOutput;
+
+/* Feed every push-buffer method here. Returns 1 if it was a transform-program
+ * method (program, constants, load cursors, execution mode). */
+int nv2a_vsh_method(uint32_t method, uint32_t param);
+
+/* 1 when the transform unit is in program mode with a program loaded. */
+int nv2a_vsh_active(void);
+
+/* The current value of attribute `attr` (0..15): what the program reads from
+ * an input that no vertex array feeds. */
+void nv2a_vsh_current(int attr, float out[4]);
+
+/* Run the loaded program on one vertex. `in` is v0..v15. Returns 0 if the
+ * program could not be run (none loaded, or it ran off the end). */
+int nv2a_vsh_run(const float in[16][4], NvVshOutput *out);
+
+/* Trace the next `runs` vertex runs step by step to stderr (diagnostics). */
+void nv2a_vsh_trace(int runs);
+
+#endif
