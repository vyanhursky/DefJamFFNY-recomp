             uint32_t count  = (w >> 18) & 0x7FFu;
             uint32_t subch  = (w >> 13) & 7u;
@@ -195,6 +247,11 @@ static uint32_t pb_segment(uint32_t va, uint32_t end_va, uint32_t *jump_va)
                 va += 4;
