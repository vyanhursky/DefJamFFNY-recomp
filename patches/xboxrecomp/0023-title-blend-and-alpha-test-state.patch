     g_pg.initialized = 1;
 
     fprintf(stderr, "[PGRAPH-D3D11] Translator initialized\n");
@@ -534,6 +553,14 @@ int pgraph_d3d11_method(int subchannel, uint32_t method, uint32_t param)
         g_pg.alpha_test = param ? 1 : 0;
