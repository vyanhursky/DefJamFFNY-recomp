+/* Texels one row of a linear texture spans in memory: the pitch, which can be
+ * wider than the image. The translator is sent the whole row width, so rows
+ * land where they are, and coordinates are normalised by it; this title's
+ * movie frames are 640 wide in rows of a wider pitch, and copying them as
+ * packed 640-texel rows slanted every line. */
+static uint32_t linear_row_texels(void)
+{
+    uint32_t bpp;
+
+    if (tex_size_from_format(s_gpu.tex.color) || !s_gpu.tex.pitch)
+        return s_gpu.tex.width;
+    bpp = d3d8_format_bpp(s_gpu.tex.color) / 8u;
+    if (!bpp || s_gpu.tex.pitch % bpp || s_gpu.tex.pitch / bpp < s_gpu.tex.width)
+        return s_gpu.tex.width;
+    return s_gpu.tex.pitch / bpp;
+}
