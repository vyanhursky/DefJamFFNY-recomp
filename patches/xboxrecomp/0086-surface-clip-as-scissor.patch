         vp.MaxDepth = 1.0f;
         ID3D11DeviceContext_RSSetViewports(g_device_state.d3d11_context, 1, &vp);
     }
+    d3d8_SetScissorRect(0, 0, 0, 0);
 
     /* Initialize shader and state subsystems */
     hr = d3d8_shaders_init();
