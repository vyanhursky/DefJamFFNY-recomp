diff --git a/templates/runtime/recomp_types.h b/templates/runtime/recomp_types.h
index e4c0f2f..576e9ff 100644
--- a/templates/runtime/recomp_types.h
+++ b/templates/runtime/recomp_types.h
@@ -297,6 +297,24 @@ static inline int64_t recomp_fist(double value, uint16_t control, unsigned bits)
     return (int64_t)rounded;
 }
 
+/* FRNDINT: round to an integer in the mode the control word selects (bits
+ * 10-11), like recomp_fist. A C runtime's floor() and ceil() are this
+ * instruction between two FLDCWs, so with the mode ignored they both rounded
+ * to nearest: floor(2.6) was 3. */
+static inline double recomp_frndint(double value, uint16_t control) {
+    switch((control>>10)&3) {
+    case 1: return floor(value);
+    case 2: return ceil(value);
+    case 3: return trunc(value);
+    default: {
+        double lo=floor(value), fraction=value-lo;
+        if(!isfinite(value)) return value;
+        if(fraction>0.5 || (fraction==0.5 && fmod(lo,2.0)!=0.0)) return lo+1.0;
+        return lo;
+    }
+    }
+}
+
